source leaprc.protein.ff19SB
source leaprc.water.opc
source leaprc.gaff2
loadamberparams frcmod.ionslm_126_opc
loadamberparams lig.frcmod
LIG = loadmol2 lig.mol2
PROT = loadpdb prot_clean.pdb
COMPLEX = combine { PROT LIG }
check COMPLEX
solvatebox COMPLEX OPCBOX 12.0
addions COMPLEX Na+ 0
addions COMPLEX Cl- 0
addIonsRand COMPLEX Na+ 53 Cl- 53
savepdb COMPLEX /nfs/lambda_stor_01/homes/rzhu/Biochemical_agent/docs/notes/md/NylC_holo_solvated_regen.pdb
saveamberparm COMPLEX /nfs/lambda_stor_01/homes/rzhu/Biochemical_agent/docs/notes/md/NylC_holo.prmtop /nfs/lambda_stor_01/homes/rzhu/Biochemical_agent/docs/notes/md/NylC_holo.inpcrd
quit
