# Copy to a local .env and configure only the provider you intend to use.
# Never commit real credentials.

# ENZYME_AGENT_MODEL=argo:claude-5-sonnet
# ARGO_BASE_URL=https://your-authorized-proxy.example/v1
# ARGO_API_KEY=

# ENZYME_AGENT_MODEL=claude-code:claude-sonnet-5-5
# Requires the separately installed and authenticated Claude Code CLI.
# ENZYME_CLAUDE_EFFORT=high

# Optional model providers:
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Discovery behavior (see config.py for the defaults and interaction):
# ENZYME_AGENT_ADAPTIVE_REASONING=1
# ENZYME_AGENT_AUTO_TARGET_REVIEW=0
# ENZYME_MODEL_CONTEXT_MAX_CHARS=120000
# Set an empty value to disable persistent descriptor caching:
# ENZYME_SUBSTRATE_CACHE_DIR=
